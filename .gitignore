# Stray temp Python probes at the root (e.g. tmpXXXXXX.ai.py from
# debugging sessions). These often carry hard-coded API keys — never
# commit them. Rename to scripts/<purpose>.py if a real keeper.
/tmp*.py
/tmp*.ai.py

# Journey runner per-run output (baselines/ is committed; runs/ is ephemeral)
tests/journeys/runs/

# GUI (Tauri + React) build artefacts
gui/node_modules/
gui/dist/
gui/dist-ssr/
gui/coverage/
gui/playwright-report/
gui/test-results/
gui/src-tauri/target/
node_modules/

__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
build/
dist/
*.egg-info/

.streamlit/

.vscode/
.idea/
