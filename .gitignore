**log.*
# `**log.*` is broad — it would otherwise eat our activity-log Python
# source. Whitelist it explicitly.
!launcher/activity_log.py
!tests/test_activity_log.py

# Tauri-generated schemas (regenerated on build) and TS incremental
# build info (per-machine cache).
gui/src-tauri/gen/
gui/*.tsbuildinfo
**/*.tsbuildinfo
**/.tscache/

# Reflect (ignore new files, whitelist existing)
reflect/*
!reflect/autonomous.py
!reflect/scheduler.py

# Universal: never track __pycache__ anywhere
**/__pycache__/
