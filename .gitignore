# Sensitive files (API keys, credentials)
mcp_servers.json

# Centralised config store (project-scoped credentials + settings).
# The user-scoped one (~/.wlwl-ass/) is outside the repo so .gitignore doesn't
# matter there.
.wlwl-ass/

