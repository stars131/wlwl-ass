# wlwl-ass — .env example
#
# .env is the **fastest** way to bring a new install online: drop one of
# the keys below in, run `python agentmain.py`, and you're off. No
# Python-data-file editing, no GUI required.
#
# Resolution order (highest priority wins on key-name collision):
#   1. temp/launcher_api_configs.json   GUI 「API 配置」 tab; advanced (mixin,
#                                       multi-channel, custom callbacks).
#   2. ~/.wlwl-ass/config.json + <project>/.wlwl-ass/config.json
#                                       launcher.config_store (cli_init wizard,
#                                       /api/credentials, `python -m launcher.config set`).
#   3. .env / shell env vars            this file — recommended default.
#
# Anything you set here is loaded into os.environ at startup, so any code
# (plugins, MCP servers) can `os.environ.get('OPENAI_API_KEY')` directly.

# ── OpenAI / OAI-compatible (recommended for first-run) ──
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.4
#
# Common OAI-compatible endpoints — paste one of these as OPENAI_BASE_URL:
#   https://api.openai.com/v1                   official
#   https://api.deepseek.com/v1                 DeepSeek
#   https://api.moonshot.cn/v1                  Moonshot / Kimi
#   https://open.bigmodel.cn/api/paas/v4        智谱 GLM
#   https://openrouter.ai/api/v1                OpenRouter (multi-model)
#   https://hub.oaifree.com/v1                  OAI-Free relay
#   https://YOUR-RESOURCE.openai.azure.com      Azure OpenAI

# ── Anthropic (real endpoint or any CC-relay) ──
# Real Anthropic key (sk-ant-*) → real endpoint, no fake_cc fingerprint.
# Anything else (sk-*, cr_*, sk-user-*) → assumed relay, fake_cc enabled.
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-opus-4-7

# ── WLWL_-prefixed alternates ──
# Use these when you want a value scoped to wlwl-ass only — e.g. you
# already have OPENAI_API_KEY pointing at a different account for some
# other tool and don't want it leaking in.
# WLWL_OPENAI_API_KEY=sk-...
# WLWL_ANTHROPIC_API_KEY=sk-ant-...
# WLWL_OPENAI_BASE_URL=https://...
# WLWL_OPENAI_MODEL=...

# ── Bot tokens (optional — only set if you want IM bots auto-started) ──
# Easier: write through the GUI's Bots tab → ~/.wlwl-ass/config.json. Setting
# here works too but exposes them to other tools that read .env.
# TG_BOT_TOKEN=123456:ABC...
# FS_APP_ID=cli_a1b2c3...
# FS_APP_SECRET=...
# QQ_APP_ID=...
# QQ_APP_SECRET=...

# ── Telemetry / behavior toggles ──
# WLWL_ACTIVITY_LOG_OFF=1            # disable JSONL event logging (privacy)
# WLWL_LANG=en                       # force English prompts (default auto-detected)
