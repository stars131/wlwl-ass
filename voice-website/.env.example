# Optional build-time / runtime defaults. Most config is set at runtime
# via the Settings panel inside the running site (and persisted in localStorage).

# Window-injected default WebSocket URL. If you want to bake an env-specific
# default into the bundle, copy this file to .env and uncomment.
# VITE_DEFAULT_VOICE_WS=ws://127.0.0.1:9700/api/voice/session
